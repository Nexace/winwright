# Winwright assistant: environment variables for the bridge (bridge/server.mjs)
# ===================================================================
# Everything here is optional. The bridge authenticates off your Claude Code
# login, so it runs with nothing set. `winwright assistant` sets
# JARVIS_WINWRIGHT_EXE and JARVIS_PTT_TOKEN itself.
#
# These are read from the environment of the shell that starts the bridge.
# Set them as Windows user environment variables (never commit a real key),
# for example in PowerShell:
#   [Environment]::SetEnvironmentVariable('ELEVENLABS_API_KEY','sk_...','User')
# Values are shown with their defaults; leave them unset to accept the default.

# Port the bridge listens on. The page is served from it: http://localhost:8787/
# JARVIS_BRIDGE_PORT=8787

# The model the bridge asks Claude Code to run.
# JARVIS_MODEL=claude-opus-5

# Reasoning effort.
# JARVIS_EFFORT=high

# Minutes without a connection or a message before the bridge stops (0 = never).
# JARVIS_IDLE_MINUTES=10

# Allow effectful built-in and third-party tools (shell, file writes, sending).
# Off by default. Winwright's desktop tools do not need it: Winwright asks the
# user itself. Read the decideTool gate in bridge/server.mjs before turning it on.
# JARVIS_ALLOW_WRITES=0

# Extra browser origins allowed to open the agent WebSocket, comma separated.
# The bridge's own page is always allowed. Default: none.
# JARVIS_ALLOWED_ORIGINS=

# Allow clients that send no Origin header at all (curl, scripts, native apps).
# Off by default, because that is also what local malware looks like. Default 0.
# JARVIS_ALLOW_NO_ORIGIN=0

# Extra directories the bridge's /file endpoint may serve from, comma separated.
# Your home directory and the system temp directory are always included. Default: none.
# JARVIS_FILE_ROOTS=

# ElevenLabs voice id for spoken replies. Default: George.
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs API key (starts with sk_). Optional: with it the mic works
# (Scribe transcription) and spoken requests get spoken replies; without it,
# type instead. The bridge also finds it in an elevenlabs MCP server entry in
# ~/.claude.json. Default: none.
# ELEVENLABS_API_KEY=
