{
  "name": "jarvis",
  "private": true,
  "version": "0.0.0",
  "description": "Winwright's chat and voice assistant: a small Node bridge that runs Claude Code and serves its own page, with Winwright as the desktop hands.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bridge/server.mjs",
    "test": "node --test bridge/*.test.mjs",
    "lint": "oxlint",
    "bridge:writes": "JARVIS_ALLOW_WRITES=1 node bridge/server.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "dompurify": "^3.4.12",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "oxlint": "^1.75.0"
  }
}
